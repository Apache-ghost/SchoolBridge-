{
  "name": "schoolbridge-multi-region-service",
  "version": "1.0.0",
  "description": "Multi-region communication service with load balancing and failover",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:us-east": "REGION=us-east-1 PORT=8001 node server.js",
    "start:us-west": "REGION=us-west-2 PORT=8002 node server.js", 
    "start:eu-west": "REGION=eu-west-1 PORT=8003 node server.js",
    "start:ap-southeast": "REGION=ap-southeast-1 PORT=8004 node server.js"
  },
  "keywords": [
    "multi-region",
    "load-balancing",
    "failover",
    "cloud",
    "distributed"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}