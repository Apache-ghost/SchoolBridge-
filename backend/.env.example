# SchoolBridge Parent-Teacher Communication System Configuration

# Database
MONGO_URL=mongodb://localhost:27017/schoolbridge_communication

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# SMS Service (Twilio example - replace with your provider)
SMS_ENABLED=true
SMS_API_KEY=your_twilio_api_key
SMS_API_URL=https://api.twilio.com/2010-04-01
SMS_FROM_NUMBER=+1234567890
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
DEFAULT_COUNTRY_CODE=+1

# School Information
SCHOOL_NAME=Demo Elementary School
SCHOOL_CODE=DEMO001

# Email (Optional)
EMAIL_ENABLED=false
EMAIL_SERVICE=gmail
EMAIL_USER=school@example.com
EMAIL_PASSWORD=your_email_password

# Push Notifications (Optional)
FCM_SERVER_KEY=your_firebase_server_key
FCM_SENDER_ID=your_firebase_sender_id

# Features Toggle
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EMERGENCY_BROADCAST=true

# Rate Limiting
SMS_RATE_LIMIT_PER_MINUTE=10
EMAIL_RATE_LIMIT_PER_MINUTE=5